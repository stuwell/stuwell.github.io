rules_version = '2';
// StuWell security rules: paste into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    // Founding StuWell administrator account(s).
    function isFounder() { return signedIn() && request.auth.uid in ["vd08cZLkynTCpeuzYyM1gecHVBy2"]; }
    function hasStaffDoc() { return signedIn() && exists(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data; }
    // StuWell administrators see every school.
    function isAdmin() { return isFounder() || (hasStaffDoc() && me().get("admin", false) == true); }
    function mySchool() { return me().get("schoolKey", ""); }
    function isStaffOf(key) { return hasStaffDoc() && key is string && key != "" && mySchool() == key; }
    function isDirectorOf(key) { return isStaffOf(key) && me().role == "director"; }
    function shortText(v, max) { return v is string && v.size() <= max; }
    // A school's key is its name in lower case.
    function keyMatches(d) { return d.school is string && d.schoolKey is string && d.schoolKey == d.school.lower().trim(); }
    function schoolOf(key) { return get(/databases/$(database)/documents/schools/$(key)).data; }
    function codeFor(key, role) { return get(/databases/$(database)/documents/schoolCodes/$(key)).data.get(role + "Code", ""); }

    // Staff must use a confirmed school mailbox: not a public provider, not a student mailbox.
    function emailDomain() { return request.auth.token.email.lower().split("@")[1]; }
    function schoolEmail() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == "password"
        && request.auth.token.email_verified == true
        && !(emailDomain() in ["gmail.com", "googlemail.com", "outlook.com", "outlook.fr", "hotmail.com", "hotmail.fr", "live.com", "live.fr", "msn.com", "yahoo.com", "yahoo.fr", "ymail.com", "icloud.com", "me.com", "aol.com", "protonmail.com", "proton.me", "gmx.com", "gmx.fr", "mail.com", "yandex.com", "menara.ma"])
        && !(emailDomain().split("[.]")[0] in ["etu", "edu", "student", "students", "etud", "stu"]);
    }

    // Registered schools: name and email domain. Everyone can read the list.
    // A confirmed school email can register its own school and becomes its "founder".
    match /schools/{key} {
      allow read: if true;
      allow create: if isAdmin()
        || (schoolEmail() && !hasStaffDoc()
          && request.resource.data.keys().hasOnly(["name", "domain", "founder", "ts"])
          && shortText(request.resource.data.name, 60) && request.resource.data.name.size() >= 3
          && key == request.resource.data.name.lower().trim()
          && request.resource.data.domain == emailDomain()
          && request.resource.data.founder == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Each school's two access codes. Administrators and that school's directors manage them.
    match /schoolCodes/{key} {
      allow read: if isAdmin() || isDirectorOf(key);
      allow write: if (isAdmin() || isDirectorOf(key))
        && request.resource.data.keys().hasOnly(["directorCode", "professorCode", "ts"])
        && request.resource.data.directorCode is string && request.resource.data.directorCode.size() >= 8
        && request.resource.data.professorCode is string && request.resource.data.professorCode.size() >= 8
        && request.resource.data.directorCode != request.resource.data.professorCode;
    }

    // Staff. A person with a confirmed email at the school's domain joins with that school's code
    // for their role; the person who registered the school becomes its first director.
    match /staff/{uid} {
      allow read: if isSelf(uid) || isAdmin() || isDirectorOf(resource.data.schoolKey);
      allow create: if (isSelf(uid) && schoolEmail()
          && request.resource.data.keys().hasOnly(["name", "email", "school", "schoolKey", "role", "code", "ts"])
          && request.resource.data.role in ["director", "professor"]
          && shortText(request.resource.data.name, 80)
          && shortText(request.resource.data.school, 60)
          && request.resource.data.email == request.auth.token.email
          && keyMatches(request.resource.data) && request.resource.data.schoolKey != ""
          && schoolOf(request.resource.data.schoolKey).domain == emailDomain()
          && ((request.resource.data.role == "director" && schoolOf(request.resource.data.schoolKey).founder == uid)
            || (request.resource.data.code is string && request.resource.data.code.size() >= 8
              && request.resource.data.code == codeFor(request.resource.data.schoolKey, request.resource.data.role))))
        || (isAdmin()
          && request.resource.data.keys().hasOnly(["name", "email", "school", "schoolKey", "role", "code", "ts", "admin"])
          && request.resource.data.role in ["director", "professor"]);
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(["name", "email", "school", "schoolKey", "role", "code", "ts", "admin"])
        && request.resource.data.role in ["director", "professor"];
      allow delete: if !isSelf(uid) && (isAdmin() || isDirectorOf(resource.data.schoolKey));
    }

    // What a student chose to share. Each student writes only their own document;
    // staff read only the students of their own school.
    match /shared/{uid} {
      allow read: if isSelf(uid) || isAdmin() || isStaffOf(resource.data.schoolKey);
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(["name", "cls", "school", "schoolKey", "year", "massar", "share", "updated", "checkins", "checkups", "requests"])
        && (!("massar" in request.resource.data) || (request.resource.data.massar is string && request.resource.data.massar.matches("[A-Z][0-9]{9}")))
        && keyMatches(request.resource.data)
        && request.resource.data.checkins.size() <= 12
        && request.resource.data.checkups.size() <= 8
        && request.resource.data.requests.size() <= 30;
      allow delete: if isSelf(uid);
    }

    // Replies to medical requests: written by a director of the student's school, read by the student.
    match /replies/{uid} {
      allow read: if isSelf(uid) || isAdmin() || isStaffOf(resource.data.schoolKey);
      allow write: if isAdmin()
        || (isDirectorOf(request.resource.data.schoolKey)
          && get(/databases/$(database)/documents/shared/$(uid)).data.schoolKey == request.resource.data.schoolKey);
    }

    // Feedback: any visitor can send it (the ID starts with their own ID); nobody can read it from the site.
    // The StuWell team reads it in the Firebase console. A sender may delete their own message.
    match /feedback/{id} {
      allow create: if signedIn() && id.matches(request.auth.uid + "_[0-9]+")
        && request.resource.data.keys().hasOnly(["kind", "rating", "message", "name", "lang", "page", "ts"])
        && request.resource.data.kind in ["review", "suggestion", "problem"]
        && request.resource.data.rating is int && request.resource.data.rating >= 0 && request.resource.data.rating <= 5
        && request.resource.data.message is string && request.resource.data.message.size() >= 3 && request.resource.data.message.size() <= 1000
        && shortText(request.resource.data.name, 60)
        && shortText(request.resource.data.lang, 5)
        && shortText(request.resource.data.page, 20)
        && request.resource.data.ts is int;
      allow delete: if signedIn() && id.matches(request.auth.uid + "_[0-9]+");
      allow read, update: if false;
    }
  }
}
